{
  "name": "mcp-host",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-transform-types tests/server-config.test.mts",
    "test:mcp": "node scripts/test-mcp-client.mjs",
    "test:integration": "node scripts/test-integration.mjs",
    "check": "npm run lint && npm run typecheck && npm test",
    "format": "prettier --write app lib tests scripts docs README.md CONTRIBUTING.md package.json tsconfig.json .github/workflows/ci.yml",
    "format:check": "prettier --check app lib tests scripts docs README.md CONTRIBUTING.md package.json tsconfig.json .github/workflows/ci.yml"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.43",
    "@ai-sdk/react": "^3.0.118",
    "@modelcontextprotocol/sdk": "^1.25.2",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "ai": "^6.0.116",
    "katex": "^0.16.39",
    "next": "16.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "streamdown": "^2.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "type": "module"
}
