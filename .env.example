# Copia a .env.local. No subas claves reales a GitHub.
# El panel funciona sin Gemini.
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# URL fija de ESTA instalación; ajusta puerto/dominio al desplegar.
MCP_LOCAL_URL=http://localhost:3000/api/mcp
# URLs completas adicionales permitidas, separadas por coma. Sin comodines.
MCP_ALLOWED_URLS=
# Headers privados por URL exacta, JSON. Ejemplo para Neon:
# {"https://mcp.neon.tech/mcp":{"Authorization":"Bearer TU_CLAVE","x-read-only":"true"}}
MCP_SERVER_HEADERS={}
# Obligatorio en producción. Introduce este valor en «Acceso» en la app.
HOST_ACCESS_TOKEN=
# Opcional: protege /api/mcp con Authorization: Bearer <valor>.
MCP_BEARER_TOKEN=

